# .env.example
#
# Copy to .env for docker-compose (`cp .env.example .env`), then fill in
# real values. .env is gitignored and must never be committed - see
# docs/AUDIT.md S1.

APP_ENV=development

# Must match what the api service's POSTGRES_DSN uses (wired automatically
# in docker-compose.yml) - just pick a password here.
POSTGRES_PASSWORD=CHANGE_ME

# Required: random string of at least 32 characters. The service refuses to
# start without one. Generate one with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_min_32_chars_random_secret

# Optional - see docs/AUDIT.md S4/S5/M6. Safe to leave blank for local use.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=
MAX_TRANSFER_AMOUNT=1000000
